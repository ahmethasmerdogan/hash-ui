{
  "name": "uicean",
  "version": "0.6.2",
  "description": "A flat, shadow-free React 19 + Tailwind CSS v4 design system. 96 components and 83 icons \u2014 forms, tables, popovers, sheets, comboboxes, a calendar and a command palette \u2014 light and dark, five accent themes, one --radius token.",
  "keywords": [
    "react",
    "react-19",
    "tailwindcss",
    "tailwind-v4",
    "design-system",
    "component-library",
    "ui",
    "ui-kit",
    "shadcn",
    "registry",
    "dark-mode",
    "typescript",
    "accessible",
    "a11y",
    "headless",
    "components",
    "datepicker",
    "combobox",
    "command-palette",
    "data-table"
  ],
  "license": "MIT",
  "author": "Ahmet H\u00e2\u015fim Erdo\u011fan <a.erdogan6868@gmail.com>",
  "homepage": "https://uicean.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmethasmerdogan/uicean.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/ahmethasmerdogan/uicean/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/uicean.css",
    "./uicean.css": "./dist/uicean.css",
    "./presets/brand-bridge.css": "./dist/presets/brand-bridge.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
