{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "uicean": ["../../packages/core/src/index.ts"],
      "uicean-blocks": ["../../packages/blocks/src/index.ts"]
    }
  },
  /* the docs app resolves uicean-blocks to source, so it needs the same
     ambient shims for that package's optional peers */
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/blocks/src/optional-peers.d.ts"
  ]
}
