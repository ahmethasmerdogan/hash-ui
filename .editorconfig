# The repo has one style; this is it, for editors that will read it.
# Prettier defaults everywhere else.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
# trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
